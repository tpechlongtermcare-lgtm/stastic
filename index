<script>
/* ---------- W3 母體與樣本 ---------- */
(function(){
  const r=rng(7),pop=[],nf=[16,16,16,40],names=['A 機構','B 機構','C 機構','D 機構（失智專區）'];
  for(let f=0;f<4;f++){const idx=[...Array(100).keys()];for(let i=99;i>0;i--){const j=Math.floor(r()*(i+1));[idx[i],idx[j]]=[idx[j],idx[i]];}const fs=new Set(idx.slice(0,nf[f]));for(let k=0;k<100;k++)pop.push({f,k,fall:fs.has(k)});}
  const sr=rng(11);let sel=new Set(),last='srs',recs=[];
  const lab={srs:'簡單隨機',strat:'分層',conv:'便利'};
  function choose(pool,k){const a=[...pool];for(let i=a.length-1;i>0;i--){const j=Math.floor(sr()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a.slice(0,k);}
  const ids=f=>pop.map((p,i)=>i).filter(i=>f===undefined||pop[i].f===f);
  function sample(m,n){if(m==='conv')return choose(ids(3),Math.min(n,100));if(m==='strat'){let o=[];for(let f=0;f<4;f++)o=o.concat(choose(ids(f),Math.round(n/4)));return o;}return choose(ids(),n);}
  function run(m){const n=+$('w3n').value,s=sample(m,n);sel=new Set(s);const k=s.filter(i=>pop[i].fall).length,est=k/s.length;recs.push({m,est});last=m;return{n:s.length,k,est};}
  function say(m,o){const why={srs:'每位住民被抽中的機會都一樣，估計值會在 22% 上下跳動，但不會固定偏向某一邊。',strat:'每家機構都按比例抽到，D 家不會被抽太多或太少，所以估計值通常比簡單隨機更接近 22%。',conv:'只抽 D 家，等於在估計「失智專區」的跌倒率，不管抽幾次都落在 40% 附近，這就是抽樣偏差。'};
    $('w3say').innerHTML=`<b>${lab[m]}抽樣：</b>抽 ${o.n} 人，其中 ${o.k} 人跌倒，估計跌倒率 <b>${fx(o.est*100)}%</b>（母體真值 22%）。${why[m]}`;}
  document.querySelectorAll('#lab3 [data-m]').forEach(b=>b.onclick=()=>{const o=run(b.dataset.m);say(b.dataset.m,o);Draw[3]();});
  $('w3rep').onclick=()=>{let o;for(let i=0;i<20;i++)o=run(last);say(last,o);Draw[3]();};
  $('w3clr').onclick=()=>{recs=[];sel=new Set();$('w3say').textContent='紀錄已清除，按任一個抽樣按鈕重新開始。';Draw[3]();};
  $('w3n').oninput=e=>{$('w3nv').textContent=e.target.value;};
  function drawPop(){const el=$('w3pop'),w=W(el),cell=Math.min(17,(w-20)/21.6),gap=cell*1.6,gw=cell*10,L=22,H=L*2+gw*2+gap+6,ox=(w-(gw*2+gap))/2;let s='';
    for(let f=0;f<4;f++){const qx=ox+(f%2)*(gw+gap),qy=L+(f<2?0:gw+gap+L);s+=`<text x="${qx}" y="${qy-6}" class="al">${names[f]}</text>`;
      pop.forEach((p,i)=>{if(p.f!==f)return;const cx=qx+(p.k%10+0.5)*cell,cy=qy+(Math.floor(p.k/10)+0.5)*cell,on=sel.has(i);
        s+=`<circle cx="${cx}" cy="${cy}" r="${cell*(on?0.4:0.32)}" fill="${p.fall?C.red:'#fff'}" stroke="${on?C.sat:(p.fall?C.red:C.line)}" stroke-width="${on?2.4:1}"/>`;});}
    put(el,w,H,s,'400 位住民的點陣圖');}
  function drawStrip(){const el=$('w3strip'),w=W(el),H=150,P=new Plot(w,H,{l:86,r:16,t:10,b:34},[0,0.6],[0,3]);let s=P.axes({xt:ticks(0,0.6,6),xf:v=>Math.round(v*100)+'%',xl:'樣本跌倒率'});
    ['srs','strat','conv'].forEach((m,j)=>{const y=P.y(2.5-j);s+=`<text x="${P.x0-8}" y="${y+4}" class="al" text-anchor="end">${lab[m]}</text>`;
      recs.forEach((q,i)=>{if(q.m!==m)return;const jit=((i*37)%11-5)*1.6;s+=`<circle cx="${P.x(q.est)}" cy="${y+jit}" r="4" fill="${m==='conv'?C.red:C.teal}" fill-opacity=".55"/>`;});});
    s+=`<line x1="${P.x(0.22)}" x2="${P.x(0.22)}" y1="${P.y1}" y2="${P.y0}" stroke="${C.ink}" stroke-dasharray="4 3" stroke-width="1.5"/>`;
    const last3=recs.length?recs[recs.length-1]:null;if(last3){const j=['srs','strat','conv'].indexOf(last3.m);s+=`<circle cx="${P.x(last3.est)}" cy="${P.y(2.5-j)}" r="7" fill="none" stroke="${C.sat}" stroke-width="2.5"/>`;}
    put(el,w,H,s,'每次抽樣的估計值');}
  Draw[3]=()=>{drawPop();drawStrip();};
})();

/* ---------- W4 資料整理 ---------- */
