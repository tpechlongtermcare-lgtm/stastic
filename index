           ['B1',0,3,1],['B2',0,5,0],['B3',0,7,1],['B4',0,9,0],['B5',0,10,1],['B6',0,12,0],['B7',0,12,0],['B8',0,12,0]];
  const D0=D.map(r=>r.slice());$('w14rst').onclick=()=>{D.forEach((r,i)=>r[3]=D0[i][3]);Draw[14]();};
  const km=g=>{const r=D.filter(d=>d[1]===g).sort((a,b)=>a[2]-b[2]);let S=1,atRisk=r.length;const steps=[[0,1]],cens=[];let i=0;
    while(i<r.length){const t=r[i][2];let d=0,c=0;while(i<r.length&&r[i][2]===t){r[i][3]?d++:c++;i++;}if(d){steps.push([t,S]);S*=1-d/atRisk;steps.push([t,S]);}if(c)cens.push([t,S]);atRisk-=d+c;}
    steps.push([12,S]);return{steps,cens,S};};
  const median=st=>{for(const[t,s]of st)if(s<=0.5)return t;return null;};
  function logrank(){const times=[...new Set(D.filter(d=>d[3]).map(d=>d[2]))].sort((a,b)=>a-b);let O1=0,E1=0,V=0,O0=0;
    times.forEach(t=>{const risk=D.filter(d=>d[2]>=t),n=risk.length,n1=risk.filter(d=>d[1]===1).length,dd=D.filter(d=>d[2]===t&&d[3]),dn=dd.length,d1=dd.filter(d=>d[1]===1).length;O1+=d1;O0+=dn-d1;E1+=dn*n1/n;if(n>1)V+=dn*(n1/n)*(1-n1/n)*(n-dn)/(n-1);});
    const E0=O1+O0-E1,chi=V>0?(O1-E1)**2/V:0;return{chi,p:chiP(chi,1),hr:(O1/E1)/(O0/E0),O1,O0};}
  Draw[14]=function(){const el=$('w14sw'),w=W(el),rowH=20,H=D.length*rowH+44,P=new Plot(w,H,{l:52,r:20,t:8,b:36},[0,12],[0,D.length]);
