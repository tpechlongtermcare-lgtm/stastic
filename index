    const sv=put(el,w,H,s,'住民追蹤圖');sv.querySelectorAll('g[data-i]').forEach(g=>{const go=()=>{const d=D[+g.dataset.i];d[3]=d[3]?0:1;Draw[14]();};g.onclick=go;g.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}};});
    const k1=km(1),k0=km(0),ek=$('w14km'),K=new Plot(w,240,{l:52,r:20,t:24,b:40},[0,12],[0,1]);let q=K.axes({xt:[0,2,4,6,8,10,12],yt:[0,.25,.5,.75,1],yf:v=>Math.round(v*100)+'%',xl:'入住後月數',yl:'尚未跌倒的比例'});
    q+=`<line x1="${K.x0}" x2="${K.x1}" y1="${K.y(.5)}" y2="${K.y(.5)}" stroke="${C.mute}" stroke-dasharray="3 3"/>`;
    [[k1,C.red],[k0,C.teal]].forEach(([k,col])=>{q+=`<path d="${k.steps.map((p,i)=>(i?'L':'M')+K.x(p[0]).toFixed(1)+' '+K.y(p[1]).toFixed(1)).join('')}" fill="none" stroke="${col}" stroke-width="2.6"/>`;k.cens.forEach(([t,S])=>{q+=`<line x1="${K.x(t)}" x2="${K.x(t)}" y1="${K.y(S)-6}" y2="${K.y(S)+6}" stroke="${col}" stroke-width="2"/>`;});});
    put(ek,w,240,q,'Kaplan-Meier 曲線');
    const lr=logrank(),m1=median(k1.steps),m0=median(k0.steps);
    $('w14read').innerHTML=`<div><small>有跌倒史：跌倒人數</small><strong>${lr.O1} ／ 8</strong></div><div><small>無跌倒史：跌倒人數</small><strong>${lr.O0} ／ 8</strong></div><div><small>中位跌倒時間</small><strong>${m1!==null?m1+' 月':'未達'} vs ${m0!==null?m0+' 月':'未達'}</strong></div><div><small>log-rank χ²</small><strong>${fx(lr.chi,2)}</strong></div><div><small>p 值</small><strong>${fp(lr.p)}</strong></div><div><small>風險比 HR（近似）</small><strong>${isFinite(lr.hr)?fx(lr.hr,2):'—'}</strong></div>`;
    $('w14say').innerHTML=`12 個月時，有跌倒史組還有 ${fx(k1.S*100,0)}% 沒跌倒，無跌倒史組還有 ${fx(k0.S*100,0)}%。`+(lr.p<0.05?`log-rank 檢定 p ${fpe(lr.p)}，兩條曲線有顯著差異，有跌倒史者較快發生跌倒（HR 約 ${fx(lr.hr,1)}）。`:`log-rank 檢定 p ${fpe(lr.p)}，未達顯著。每組只有 8 人，就算曲線看起來分得開，證據仍不夠強。`)+`<br>曲線上的短直線是設限的住民。`;};
