const $=id=>document.getElementById(id);
const fx=(v,d=1)=>Number(v).toFixed(d);
const fp=p=>p<0.001?'< 0.001':p.toFixed(3);
const fpe=p=>p<0.001?'&lt; 0.001':'＝ '+p.toFixed(3);
const sum=a=>a.reduce((s,v)=>s+v,0);
const mean=a=>sum(a)/a.length;
const sd=a=>{const m=mean(a);return Math.sqrt(sum(a.map(v=>(v-m)**2))/(a.length-1));};
const quant=(a,q)=>{const s=[...a].sort((x,y)=>x-y);const p=(s.length-1)*q;const lo=Math.floor(p),hi=Math.ceil(p);return s[lo]+(s[hi]-s[lo])*(p-lo);};
function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function randn(r){let u=0,v=0;while(!u)u=r();while(!v)v=r();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);}
function gammaln(x){const c=[76.18009172947146,-86.50532032941677,24.01409824083091,-1.231739572450155,0.1208650973866179e-2,-0.5395239384953e-5];let y=x,t=x+5.5;t-=(x+0.5)*Math.log(t);let s=1.000000000190015;for(let j=0;j<6;j++)s+=c[j]/++y;return -t+Math.log(2.5066282746310005*s/x);}
function betacf(a,b,x){const F=1e-300;let qab=a+b,qap=a+1,qam=a-1,c=1,d=1-qab*x/qap;if(Math.abs(d)<F)d=F;d=1/d;let h=d;for(let m=1;m<=300;m++){const m2=2*m;let aa=m*(b-m)*x/((qam+m2)*(a+m2));d=1+aa*d;if(Math.abs(d)<F)d=F;c=1+aa/c;if(Math.abs(c)<F)c=F;d=1/d;h*=d*c;aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2));d=1+aa*d;if(Math.abs(d)<F)d=F;c=1+aa/c;if(Math.abs(c)<F)c=F;d=1/d;const del=d*c;h*=del;if(Math.abs(del-1)<1e-12)break;}return h;}
function ibeta(a,b,x){if(x<=0)return 0;if(x>=1)return 1;const bt=Math.exp(gammaln(a+b)-gammaln(a)-gammaln(b)+a*Math.log(x)+b*Math.log(1-x));return x<(a+1)/(a+b+2)?bt*betacf(a,b,x)/a:1-bt*betacf(b,a,1-x)/b;}
const tP=(t,df)=>ibeta(df/2,0.5,df/(df+t*t));
const fP=(f,d1,d2)=>f<=0?1:ibeta(d2/2,d1/2,d2/(d2+d1*f));
function gammp(a,x){if(x<=0)return 0;if(x<a+1){let ap=a,s=1/a,del=s;for(let n=0;n<300;n++){ap++;del*=x/ap;s+=del;if(Math.abs(del)<Math.abs(s)*1e-13)break;}return s*Math.exp(-x+a*Math.log(x)-gammaln(a));}let b=x+1-a,c=1e300,d=1/b,h=d;for(let i=1;i<300;i++){const an=-i*(i-a);b+=2;d=an*d+b;if(Math.abs(d)<1e-300)d=1e-300;c=b+an/c;if(Math.abs(c)<1e-300)c=1e-300;d=1/d;const del=d*c;h*=del;if(Math.abs(del-1)<1e-13)break;}return 1-Math.exp(-x+a*Math.log(x)-gammaln(a))*h;}
const chiP=(x,df)=>1-gammp(df/2,x/2);
function phi(z){const t=1/(1+0.3275911*Math.abs(z)/Math.SQRT2);const y=1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*Math.exp(-z*z/2);return z>=0?(1+y)/2:(1-y)/2;}
const dnorm=(x,m,s)=>Math.exp(-0.5*((x-m)/s)**2)/(s*Math.sqrt(2*Math.PI));
const lfact=n=>gammaln(n+1);
function fisher(a,b,c,d){const r1=a+b,r2=c+d,c1=a+c,n=r1+r2;const lp=x=>lfact(r1)+lfact(r2)+lfact(c1)+lfact(n-c1)-lfact(n)-lfact(x)-lfact(r1-x)-lfact(c1-x)-lfact(r2-c1+x);const p0=lp(a);let p=0;for(let x=Math.max(0,c1-r2);x<=Math.min(r1,c1);x++){const v=lp(x);if(v<=p0+1e-7)p+=Math.exp(v);}return Math.min(1,p);}
function ticks(a,b,n=5){const st0=(b-a)/n,mag=Math.pow(10,Math.floor(Math.log10(st0))),e=st0/mag,st=(e>=7.5?10:e>=3.5?5:e>=1.5?2:1)*mag,o=[];for(let v=Math.ceil(a/st)*st;v<=b+1e-9;v+=st)o.push(+v.toFixed(10));return o;}
class Plot{constructor(w,h,m,xd,yd){Object.assign(this,{w,h,m,xd,yd});}
 x(v){const{m,w,xd}=this;return m.l+(v-xd[0])/(xd[1]-xd[0])*(w-m.l-m.r);}
 y(v){const{m,h,yd}=this;return h-m.b-(v-yd[0])/(yd[1]-yd[0])*(h-m.t-m.b);}
 get x0(){return this.m.l}get x1(){return this.w-this.m.r}get y0(){return this.h-this.m.b}get y1(){return this.m.t}
 axes({xt=[],yt=[],xl='',yl='',xf=v=>v,yf=v=>v,noXgrid=false}={}){let s='';
  yt.forEach(v=>{const y=this.y(v);s+=`<line x1="${this.x0}" x2="${this.x1}" y1="${y}" y2="${y}" class="gl"/><text x="${this.x0-6}" y="${y+4}" class="tk" text-anchor="end">${yf(v)}</text>`;});
  xt.forEach(v=>{const x=this.x(v);if(!noXgrid)s+=`<line y1="${this.y1}" y2="${this.y0}" x1="${x}" x2="${x}" class="gl"/>`;s+=`<text x="${x}" y="${this.y0+16}" class="tk" text-anchor="middle">${xf(v)}</text>`;});
  s+=`<line x1="${this.x0}" x2="${this.x1}" y1="${this.y0}" y2="${this.y0}" class="ax"/>`;
