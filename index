<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F4F7F6">
<title>統計方法互動手冊｜長照情境版</title>
<style>
:root{--paper:#F4F7F6;--ink:#1D2B3A;--mute:#5B6B78;--grid:#DCE4E1;--teal:#0F6E66;--tealL:#D5EAE6;--sat:#C98A12;--satL:#F7E6BF;--red:#B9412F;--redL:#F3D6CF;
--sans:"Noto Sans TC","Noto Sans CJK TC","PingFang TC","Microsoft JhengHei","Heiti TC",sans-serif;
--serif:"Noto Serif TC","Noto Serif CJK TC","Songti TC","PMingLiU",serif;}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.75;font-variant-numeric:tabular-nums}
.top{position:sticky;top:0;z-index:5;background:var(--paper);border-bottom:1px solid var(--grid)}
.brand{max-width:1080px;margin:0 auto;padding:14px 20px 4px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.brand h1{font-family:var(--serif);font-size:20px;margin:0;font-weight:700;letter-spacing:.02em}
.brand p{margin:0;color:var(--mute);font-size:13px}
.strip-wrap{overflow-x:auto;padding:0 20px 8px;scrollbar-width:thin}
.strip{display:grid;grid-template-columns:repeat(18,minmax(54px,1fr));max-width:1040px;margin:0 auto;min-width:972px}
.phase{grid-row:1;font-size:12px;color:var(--mute);border-bottom:2px solid var(--ink);padding:0 4px 2px;margin:0 3px;white-space:nowrap}
.wkbtn{grid-row:2;appearance:none;border:0;border-right:1px solid var(--grid);background:transparent;padding:6px 2px 7px;font:inherit;cursor:pointer;color:var(--ink);text-align:center;line-height:1.25}
.wkbtn:first-of-type{border-left:1px solid var(--grid)}
.wkbtn .n{display:block;font-size:15px;font-weight:700}
.wkbtn .s{display:block;font-size:11px;color:var(--mute);white-space:nowrap}
.wkbtn:disabled{cursor:default;opacity:.35}
.wkbtn:not(:disabled):not([aria-current="true"]):hover{background:#E6EDEA}
.wkbtn[aria-current="true"]{background:var(--ink);color:#fff}
.wkbtn[aria-current="true"] .s{color:#C9D3DB}
button:focus-visible,input:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--sat);outline-offset:2px}
main{max-width:880px;margin:0 auto;padding:26px 20px 90px}
.topic{display:none}.topic.on{display:block}
.wk{font-size:14px;color:var(--mute);margin:0}
.topic h2{font-family:var(--serif);font-size:32px;line-height:1.3;margin:2px 0 10px;font-weight:700}
.lede{font-size:18px;margin:0 0 8px;max-width:38em}
h3{font-size:18px;margin:38px 0 12px;padding-top:16px;border-top:1px solid var(--grid)}
h4{font-size:15px;margin:22px 0 8px}
p{margin:0 0 12px;max-width:42em}
.flow{display:flex;align-items:stretch;margin:6px 0 12px}
.st{flex:1 1 0;background:#fff;border:1px solid #C5D1CC;border-radius:6px;padding:10px 12px;min-width:0}
.st b{display:block;font-size:15px;line-height:1.4}
.st span{display:block;font-size:13px;color:var(--mute);line-height:1.55;margin-top:3px}
.st.key{border:1.5px solid var(--teal);background:#F3FAF8}
.ar{flex:0 0 26px;position:relative}
.ar::before{content:"";position:absolute;left:5px;right:8px;top:50%;border-top:1.5px solid var(--ink)}
.ar::after{content:"";position:absolute;right:7px;top:calc(50% - 4px);width:7px;height:7px;border-top:1.5px solid var(--ink);border-right:1.5px solid var(--ink);transform:rotate(45deg)}
.sub{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.sub i{font-style:normal;font-size:12px;border:1px solid #C5D1CC;border-radius:4px;padding:1px 7px;background:#fff;color:var(--ink)}
@media (max-width:640px){.flow{flex-direction:column}.ar{flex-basis:24px}.ar::before{left:50%;right:auto;top:3px;bottom:7px;border-top:0;border-left:1.5px solid var(--ink)}.ar::after{left:calc(50% - 3px);right:auto;top:auto;bottom:6px;transform:rotate(135deg)}.topic h2{font-size:26px}.lede{font-size:16px}}
.lab{border:1px solid #C5D1CC;border-radius:10px;padding:16px;margin:8px 0 10px;background-color:#fff;background-image:linear-gradient(rgba(15,110,102,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(15,110,102,.06) 1px,transparent 1px);background-size:16px 16px}
.ctl{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;margin-bottom:12px;font-size:14px}
.ctl label{display:flex;align-items:center;gap:8px;white-space:nowrap}
.ctl input[type=range]{width:150px;accent-color:var(--teal)}
.ctl output{min-width:3.2em;font-weight:700}
.btn{appearance:none;font:inherit;font-size:14px;border:1px solid var(--ink);background:#fff;color:var(--ink);border-radius:6px;padding:5px 12px;cursor:pointer;line-height:1.5}
.btn:hover{background:#EEF3F1}
.btn.pri{background:var(--teal);border-color:var(--teal);color:#fff}
.btn.pri:hover{background:#0B5A53}
.btn:disabled{opacity:.45;cursor:default}
.btn[aria-pressed="true"]{background:var(--ink);color:#fff}
.seg{display:inline-flex;border:1px solid var(--ink);border-radius:6px;overflow:hidden}
.seg .btn{border:0;border-radius:0;border-right:1px solid var(--ink)}
.seg .btn:last-child{border-right:0}
.ctl.seg{gap:0;display:inline-flex;margin-bottom:4px}
.read{display:flex;flex-wrap:wrap;gap:6px 26px;margin-top:10px;font-size:14px}
.read div{line-height:1.35}
.read small{display:block;color:var(--mute);font-size:12px}
.read strong{font-size:20px}
.say{margin-top:10px;padding:10px 12px;background:var(--paper);border-radius:6px;font-size:15px;max-width:none}
.legend{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:13px;color:var(--mute);margin:6px 0 0}
.legend span::before{content:"";display:inline-block;width:11px;height:11px;border-radius:2px;margin-right:6px;vertical-align:-1px;background:var(--c);border:1px solid var(--b,transparent)}
.case{border-left:3px solid var(--sat);padding:2px 0 2px 16px;margin:6px 0}
.case p b{color:var(--ink)}
.pit p{padding-left:0}
.hint{font-size:14px;color:var(--mute)}
.tbl{border-collapse:collapse;font-size:14px;margin:6px 0 10px;background:#fff}
.tbl th,.tbl td{border:1px solid #C5D1CC;padding:6px 10px;text-align:center;line-height:1.45}
.tbl th{background:#EEF3F1;font-weight:700}
.tbl td.l,.tbl th.l{text-align:left}
.scroll{overflow-x:auto}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 12px}
.chip{appearance:none;font:inherit;font-size:14px;border:1px solid #9FB1AA;background:#fff;border-radius:999px;padding:3px 12px;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--teal);color:#fff;border-color:var(--teal)}
.types{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.types .col{background:#fff;border:1px solid #C5D1CC;border-radius:6px;padding:10px 12px;font-size:14px;line-height:1.6;transition:border-color .2s,background .2s}
.types .col.hit{border:1.5px solid var(--teal);background:#F3FAF8}
.types .col h5{margin:0 0 4px;font-size:15px}
.types .col .grp{font-size:12px;color:var(--mute)}
@media (max-width:640px){.types{grid-template-columns:1fr}}
svg text{font-family:var(--sans)}
.tk{font-size:12px;fill:var(--mute)}.al{font-size:12px;fill:var(--ink)}.gl{stroke:#E4EBE8;stroke-width:1}.ax{stroke:var(--ink);stroke-width:1}
.err{color:var(--red);font-size:13px;margin-top:6px}
.map{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:10px 0}
.map .ph{border-top:3px solid var(--ink);padding-top:8px}
.map .ph h4{margin:0 0 6px}
.map .ph button{display:block;width:100%;text-align:left;appearance:none;background:none;border:0;border-bottom:1px solid var(--grid);font:inherit;font-size:15px;padding:7px 0;cursor:pointer;color:var(--ink)}
.map .ph button span{color:var(--mute);font-size:13px;margin-right:8px}
.map .ph button:hover{color:var(--teal)}
@media (max-width:640px){.map{grid-template-columns:1fr}}
.tree{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:8px}
.tree .q{background:#fff;border:1px solid #C5D1CC;border-radius:6px;padding:10px 12px}
.tree .q b{display:block}
.tree .q span{display:block;font-size:13px;color:var(--mute)}
.tree .q a{display:block;margin-top:8px;padding-top:8px;border-top:1px dashed #C5D1CC;color:var(--teal);font-size:14px;text-decoration:none;cursor:pointer}
.tree .q a:hover{text-decoration:underline}
@media (max-width:640px){.tree{grid-template-columns:1fr}}
.fig{width:100%}
.note{font-size:13px;color:var(--mute);margin-top:6px}
footer{max-width:880px;margin:0 auto;padding:0 20px 40px;font-size:13px;color:var(--mute)}

.tools{margin-left:auto;display:flex;gap:8px}
.tools .btn[aria-current="true"]{background:var(--ink);color:#fff}
.term{appearance:none;background:none;border:0;padding:0;margin:0;font:inherit;color:inherit;cursor:pointer;border-bottom:1.5px dotted var(--teal);line-height:inherit}
.term:hover{color:var(--teal);background:#EAF4F2}
#pop{position:absolute;z-index:20;width:min(340px,calc(100vw - 24px));background:#fff;border:1px solid var(--ink);border-radius:8px;padding:12px 14px;font-size:14px;line-height:1.65;box-shadow:0 6px 18px rgba(29,43,58,.18)}
#pop h5{margin:0 0 4px;font-size:16px}
#pop h5 small{font-weight:400;color:var(--mute);font-size:12px;margin-left:6px}
#pop p{margin:0 0 6px}
#pop .x{position:absolute;top:6px;right:8px;appearance:none;border:0;background:none;font-size:18px;cursor:pointer;color:var(--mute);line-height:1}
#pop .more{appearance:none;border:0;background:none;padding:0;font:inherit;color:var(--teal);cursor:pointer;text-decoration:underline}
details.how{margin-top:12px;background:#fff;border:1px solid #C5D1CC;border-radius:6px;padding:8px 12px;font-size:14px}
details.how summary{cursor:pointer;font-weight:700;color:var(--teal)}
details.how ol{margin:8px 0 2px;padding-left:22px}
details.how li{margin-bottom:4px}
.gsearch{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:8px 0 6px}
.gsearch input{font:inherit;font-size:15px;padding:6px 10px;border:1px solid #9FB1AA;border-radius:6px;width:min(340px,100%);background:#fff}
.quick{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:14px;color:var(--mute);margin:6px 0 14px}
.ent{padding:14px 0 12px;border-bottom:1px solid var(--grid)}
.ent.key{border-left:3px solid var(--teal);padding-left:14px;border-radius:0}
.ent.flash{animation:flash 1.6s ease-out}
@keyframes flash{from{background:var(--satL)}to{background:transparent}}
@media (prefers-reduced-motion:reduce){.ent.flash{animation:none;background:var(--satL)}}
.ent{scroll-margin-top:calc(var(--hh,130px) + 12px)}
.ent h4{margin:0 0 6px;font-size:18px}
.ent h4 .en{font-weight:400;color:var(--mute);font-size:13px;margin-left:8px}
.ent dl{display:grid;grid-template-columns:4.5em 1fr;gap:4px 12px;margin:0;font-size:15px;max-width:44em}
.ent dt{color:var(--mute);font-size:13px;padding-top:2px}
.ent dd{margin:0}
.ent .wks{font-size:13px;color:var(--mute);margin:6px 0 0}
.ent .wks button{appearance:none;border:0;background:none;padding:0 4px;font:inherit;color:var(--teal);cursor:pointer;text-decoration:underline}
.anno{background:#fff;border:1px solid #C5D1CC;border-radius:10px;padding:16px;margin:10px 0 16px}
.anno .sent{font-size:17px;line-height:2.1;margin-bottom:10px}
.anno .sent span{border-bottom:3px solid var(--c);padding-bottom:1px}
.anno .sent sup{font-size:11px;color:var(--c);font-weight:700;margin-left:1px}
.anno ol{margin:0;padding-left:22px;font-size:15px}
.anno li{margin-bottom:6px}
.rule{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:10px 0}
.rule div{background:#fff;border:1px solid #C5D1CC;border-radius:6px;padding:10px 12px;font-size:15px}
.rule b{display:block;font-size:16px;margin-bottom:2px}
@media (max-width:640px){.rule{grid-template-columns:1fr}.ent dl{grid-template-columns:1fr}.ent dt{padding-top:6px}}
ol.steps{padding-left:0;list-style:none;margin:8px 0 10px;max-width:44em}
ol.steps li{position:relative;padding-left:30px;margin-bottom:6px}
ol.steps li i{position:absolute;left:0;top:3px;width:20px;height:20px;border-radius:50%;background:var(--sat);color:#fff;font-style:normal;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center}


.hero{background:#fff;border:1.5px solid var(--ink);border-radius:12px;padding:18px 20px 16px;margin:8px 0 12px}
.hero .hlab{font-size:13px;color:var(--mute);margin:0 0 2px}
.hero .hq{font-family:var(--serif);font-size:25px;line-height:1.45;margin:0 0 12px;font-weight:700;max-width:none}
.hero .ha{border-top:1px dashed #C5D1CC;padding-top:10px;margin:0 0 10px}
.hero .lede{font-size:16px;margin:0}
.hero .learn{font-size:15px;margin:0 0 12px}
@media (max-width:640px){.hero .hq{font-size:21px}.hero{padding:14px 14px}}
.stages{display:flex;flex-wrap:wrap;gap:6px 8px;align-items:center;font-size:13px;color:var(--mute);margin:0 0 4px}
.stages button{appearance:none;font:inherit;font-size:13px;border:1px solid #C5D1CC;background:#fff;border-radius:999px;padding:2px 10px 2px 3px;cursor:pointer;color:var(--ink);display:inline-flex;align-items:center}
.stages button:hover{border-color:var(--teal)}
.stages button i{font-style:normal;display:inline-flex;width:18px;height:18px;border-radius:50%;background:var(--ink);color:#fff;font-size:11px;align-items:center;justify-content:center;margin-right:5px}
h3{scroll-margin-top:calc(var(--hh,130px) + 12px)}
.flow{counter-reset:st}
.flow:not(.nonum) .st > b::before{counter-increment:st;content:counter(st);display:inline-flex;width:20px;height:20px;border-radius:50%;background:var(--ink);color:#fff;font-size:12px;align-items:center;justify-content:center;margin-right:7px;vertical-align:1px}
.startc{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;background:var(--ink);color:#fff;border-radius:10px;padding:12px 16px;margin:10px 0 10px}
.startc b{display:block;font-size:16px}
.startc span{font-size:14px;color:#C9D3DB}
.startc .btn.pri{background:var(--sat);border-color:var(--sat)}
.startc .btn.pri:hover{background:#A87310}
.say{font-size:16px;background:#EAF4F2;border:1px solid #BFDDD7}
.say::before{content:"這代表什麼";display:block;font-size:12px;font-weight:700;color:var(--teal);margin-bottom:2px}
.lab .read{border-top:1px dashed #C5D1CC;padding-top:8px;margin-top:12px}
.lab .read::before{content:"數字細節";flex-basis:100%;font-size:12px;color:var(--mute);margin-bottom:-2px}
.read:empty{display:none}
#guide{position:fixed;left:50%;transform:translateX(-50%);bottom:12px;z-index:30;width:min(720px,calc(100vw - 20px));background:var(--ink);color:#fff;border-radius:12px;padding:12px 16px 14px;box-shadow:0 10px 30px rgba(0,0,0,.28);max-height:46vh;overflow:auto}
#guide .gtop{display:flex;align-items:center;gap:12px;font-size:14px}
#guide .gtop span{color:#C9D3DB}
#guide #gx{margin-left:auto;appearance:none;background:none;border:1px solid #6B7B88;color:#fff;border-radius:6px;font:inherit;font-size:13px;padding:2px 10px;cursor:pointer}
#guide .gbar{height:4px;background:#3A4B5C;border-radius:2px;margin:8px 0 10px;overflow:hidden}
#guide .gbar i{display:block;height:100%;background:var(--sat);transition:width .3s}
#guide #gtext{font-size:16px;margin:0 0 8px;max-width:none}
#guide #gtext b{color:#F3C76A}
#guide #gwait{font-size:13px;color:#F3C76A;margin:0 0 8px}
#guide #gafter{background:#EAF4F2;color:var(--ink);border-radius:8px;padding:8px 12px;font-size:15px;margin:0 0 10px;max-width:none}
#guide #gafter b{color:var(--teal)}
#guide .gbtns{display:flex;gap:8px;justify-content:flex-end}
#guide .btn{background:transparent;color:#fff;border-color:#8797A4}
#guide .btn.pri{background:var(--sat);border-color:var(--sat);color:#fff}
#guide .btn:disabled{opacity:.4;cursor:not-allowed}
body.touring main{padding-bottom:300px}
.spot{outline:3px solid var(--sat)!important;outline-offset:4px;border-radius:6px;animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{0%,100%{outline-color:rgba(201,138,18,1)}50%{outline-color:rgba(201,138,18,.3)}}
@media (prefers-reduced-motion:reduce){.spot{animation:none}#guide .gbar i{transition:none}}
.qz{border:1px solid #C5D1CC;border-radius:10px;background:#fff;padding:10px 16px 14px;margin:0 0 12px}
.qz legend{font-weight:700;padding:0 6px;font-size:16px;line-height:1.6}
.opt{display:flex;gap:10px;align-items:flex-start;padding:7px 10px;border:1px solid transparent;border-radius:6px;cursor:pointer;font-size:15px;line-height:1.6}
.opt:hover{background:var(--paper)}
.opt input{margin-top:6px;accent-color:var(--teal)}
.opt.right{border-color:var(--teal);background:#EAF4F2}
.opt.wrong{border-color:var(--red);background:#FBEDEA}
.qact{margin-top:8px}
.qfb{margin:10px 0 0;font-size:15px;max-width:none}
.qfb.bad{color:var(--red);font-size:13px}
.qfb.good b{color:var(--teal)}.qfb.miss b{color:var(--red)}
.qsum{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;font-size:15px}
.qscore{font-weight:700}



.mnav{display:none}
.scroll{position:relative}
.scroll.scrollable{box-shadow:inset -14px 0 12px -12px rgba(29,43,58,.35)}
.shint{display:none;font-size:13px;color:var(--mute);margin:0 0 4px}
@media (max-width:720px){.shint{display:block}}
.tbl input{font-size:16px;padding:4px 6px;border:1px solid #9FB1AA;border-radius:4px}
input[type=range]{height:30px}
#totop{position:fixed;right:14px;bottom:calc(14px + env(safe-area-inset-bottom));z-index:18;display:none;opacity:0;pointer-events:none;transition:opacity .2s;width:46px;height:46px;border-radius:50%;border:1px solid var(--grid);background:#fff;color:var(--ink);font-size:19px;line-height:1;box-shadow:0 3px 12px rgba(29,43,58,.2);cursor:pointer}
#guide .gmin{appearance:none;background:none;border:1px solid #6B7B88;color:#fff;border-radius:6px;font:inherit;font-size:13px;padding:2px 9px;cursor:pointer;margin-left:8px}
#guide.min #gtext,#guide.min #gwait,#guide.min #gafter,#guide.min .gbtns,#guide.min .gbar{display:none}
@media (max-width:720px){
  .strip-wrap{display:none}
  .mnav{display:flex;gap:8px;align-items:center;padding:0 14px 10px}
  .mnav select{flex:1;min-width:0;font:inherit;font-size:16px;padding:8px 10px;border:1px solid var(--ink);border-radius:8px;background:#fff;color:var(--ink);-webkit-appearance:none;appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--ink) 50%),linear-gradient(135deg,var(--ink) 50%,transparent 50%);background-position:calc(100% - 17px) 55%,calc(100% - 12px) 55%;background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:32px}
  .mstep{appearance:none;width:42px;height:42px;flex:none;border:1px solid var(--ink);background:#fff;color:var(--ink);border-radius:8px;font-size:22px;line-height:1;cursor:pointer}
  .mstep:disabled{opacity:.3}
  main{padding:18px 14px 90px}
  .lab{padding:12px 10px}
  .ctl{gap:8px 12px}
  .ctl label{flex:1 1 100%;justify-content:space-between;gap:8px;white-space:normal;flex-wrap:wrap}
  .ctl input[type=range]{flex:1 1 auto;width:auto;min-width:90px}
  .ctl output{min-width:0;text-align:right}
  .btn{padding:7px 14px}
  .seg .btn{padding:7px 9px;font-size:13px}
  .chip{padding:6px 14px}
  .opt{padding:10px}
  .qz{padding:8px 12px 12px}
  .qsum{padding-right:54px}
  .tbl th,.tbl td{padding:6px 8px}
  #totop{display:block}
  #totop.on{opacity:1;pointer-events:auto}
  body.touring #totop{display:none}
  #guide{bottom:0;left:0;transform:none;width:100%;border-radius:14px 14px 0 0;max-height:44vh;padding:10px 14px calc(12px + env(safe-area-inset-bottom));overscroll-behavior:contain}
  #guide #gtext{font-size:15px}
  #guide #gafter{font-size:14px}
  #guide .gbtns{gap:10px}
  #guide .gbtns .btn{flex:1;padding:9px 0;font-size:15px}
