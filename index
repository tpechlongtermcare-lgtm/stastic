    $('w5read').innerHTML=`<div><small>陽性人數</small><strong>${TP+FP}</strong></div><div><small>陽性預測值 PPV</small><strong>${fx(ppv*100)}%</strong></div><div><small>陰性預測值 NPV</small><strong>${fx(npv*100)}%</strong></div><div><small>漏掉的感染者</small><strong>${FN}</strong></div>`;
    const ratio=TP+FP?FP/(TP+FP):0;
    $('w5say').innerHTML=`盛行率 ${Math.round(pv*100)}% 時，快篩陽性的 ${TP+FP} 人中，真的感染只有 ${TP} 人（PPV ${fx(ppv*100,0)}%）。`+(ratio>0.5?`<b>陽性結果裡誤報比真的還多</b>，需要搭配臨床症狀或 PCR 確認。`:ratio>0.2?`陽性結果大多可信，但仍有一部分是誤報。`:`陽性結果的可信度很高，可以更快啟動隔離與群聚處置。`);};
})();

/* ---------- W6 抽樣分配 ---------- */
(function(){
  const r=rng(21),pop=Array.from({length:5000},()=>1-7*Math.log(r()));const mu=mean(pop),sig=Math.sqrt(mean(pop.map(v=>(v-mu)**2)));
  const sr=rng(99);let n=30,means=[],lastS=[],cis=[];const tc={2:12.706,5:2.776,10:2.262,30:2.045,100:1.984};
  const draw1=()=>{const s=[];for(let i=0;i<n;i++)s.push(pop[Math.floor(sr()*5000)]);return s;};
  const segN=$('w6n');segN.querySelectorAll('.btn').forEach(b=>{b.onclick=()=>{n=+b.dataset.n;means=[];lastS=[];cis=[];pressOne(segN,b);Draw[6]();};if(+b.dataset.n===n)b.setAttribute('aria-pressed','true');});
  document.querySelectorAll('#lab6 [data-k]').forEach(b=>b.onclick=()=>{for(let k=0;k<+b.dataset.k;k++){lastS=draw1();means.push(mean(lastS));}Draw[6]();});
  $('w6clr').onclick=()=>{means=[];lastS=[];Draw[6]();};
  $('w6ci').onclick=()=>{cis=[];for(let k=0;k<20;k++){const s=draw1(),m=mean(s),h=tc[n]*sd(s)/Math.sqrt(n);cis.push([m-h,m,m+h]);}drawCI();};
  function drawPop(){const el=$('w6pop'),w=W(el),H=170,c=hist(pop,0,50,2),P=new Plot(w,H,{l:48,r:16,t:16,b:38},[0,50],[0,Math.max(...c)*1.08]);
    let s=P.axes({xt:ticks(0,50,5),yt:ticks(0,Math.max(...c),3),xl:'住院天數',xf:v=>v===50?'50+':v});
    c.forEach((v,i)=>{s+=`<rect x="${P.x(i*2)+.5}" y="${P.y(v)}" width="${P.x(2)-P.x(0)-1}" height="${P.y0-P.y(v)}" fill="#E4EBE8" stroke="${C.line}" stroke-width=".6"/>`;});
    lastS.slice(0,100).forEach(v=>{const x=P.x(Math.min(v,49.9));s+=`<line x1="${x}" x2="${x}" y1="${P.y0-14}" y2="${P.y0}" stroke="${C.sat}" stroke-width="2"/>`;});
    s+=`<line x1="${P.x(mu)}" x2="${P.x(mu)}" y1="${P.y1}" y2="${P.y0}" stroke="${C.ink}" stroke-dasharray="4 3"/><text x="${P.x(mu)+5}" y="${P.y1+10}" class="al">母體平均 μ ＝ ${fx(mu)}</text>`;
    if(lastS.length){const m=mean(lastS),x=P.x(Math.min(m,49));s+=`<path d="M${x} ${P.y0-16}l-7 -12h14z" fill="${C.sat}"/><text x="${x+10}" y="${P.y0-22}" class="al" style="fill:${C.sat};font-weight:700">這次樣本的平均 ${fx(m)}</text>`;}
    put(el,w,H,s,'母體分布');}
  function drawSamp(){const el=$('w6samp'),w=W(el),H=210,bw=0.5,lo=0,hi=24,c=hist(means,lo,hi,bw),se=sig/Math.sqrt(n),peak=Math.max(Math.max(...c),means.length*bw*dnorm(mu,mu,se),1);
    const P=new Plot(w,H,{l:48,r:16,t:16,b:38},[lo,hi],[0,peak*1.1]);let s=P.axes({xt:ticks(lo,hi,6),yt:ticks(0,peak,3),xl:'樣本平均天數'});
    c.forEach((v,i)=>{if(!v)return;s+=`<rect x="${P.x(lo+i*bw)+.5}" y="${P.y(v)}" width="${P.x(bw)-P.x(0)-1}" height="${P.y0-P.y(v)}" fill="${C.tealL}" stroke="${C.teal}" stroke-width=".6"/>`;});
    if(means.length>=50){let d='';for(let x=lo;x<=hi;x+=0.1){const y=P.y(means.length*bw*dnorm(x,mu,se));d+=(d?'L':'M')+P.x(x).toFixed(1)+' '+y.toFixed(1);}s+=`<path d="${d}" fill="none" stroke="${C.ink}" stroke-width="1.5"/>`;}
    s+=`<line x1="${P.x(mu)}" x2="${P.x(mu)}" y1="${P.y1}" y2="${P.y0}" stroke="${C.ink}" stroke-dasharray="4 3"/>`;
    if(!means.length)s+=`<text x="${(P.x0+P.x1)/2}" y="${(P.y0+P.y1)/2}" class="al" text-anchor="middle">按「抽 100 次」開始</text>`;
    if(means.length){const m=means[means.length-1],x=P.x(Math.max(lo,Math.min(hi,m)));s+=`<path d="M${x} ${P.y0-2}l-7 -12h14z" fill="${C.sat}"/><text x="${x+10}" y="${P.y0-8}" class="al" style="fill:${C.sat};font-weight:700">最新一次</text>`;}
    put(el,w,H,s,'抽樣分配');
    $('w6read').innerHTML=`<div><small>已抽樣次數</small><strong>${means.length.toLocaleString()}</strong></div><div><small>平均數的平均</small><strong>${means.length?fx(mean(means),2):'—'}</strong></div><div><small>實測標準誤（平均數的標準差）</small><strong>${means.length>1?fx(sd(means),2):'—'}</strong></div><div><small>理論標準誤 σ ÷ √n</small><strong>${fx(se,2)}</strong></div>`+(means.length>=50?`<div><small>黑色曲線</small><strong style="font-size:15px">常態分配理論值</strong></div>`:'');}
  function drawCI(){const el=$('w6cifig'),w=W(el),H=20*13+46,P=new Plot(w,H,{l:48,r:16,t:10,b:36},[0,24],[0,20]);let s=P.axes({xt:ticks(0,24,6),xl:'住院天數'}),hit=0;
    cis.forEach(([a,m,b],i)=>{const ok=a<=mu&&mu<=b;if(ok)hit++;const y=P.y(19.5-i),col=ok?C.teal:C.red;s+=`<line x1="${P.x(Math.max(0,a))}" x2="${P.x(Math.min(24,b))}" y1="${y}" y2="${y}" stroke="${col}" stroke-width="2.2"/><circle cx="${P.x(Math.min(24,Math.max(0,m)))}" cy="${y}" r="3" fill="${col}"/>`;});
    s+=`<line x1="${P.x(mu)}" x2="${P.x(mu)}" y1="${P.y1}" y2="${P.y0}" stroke="${C.ink}" stroke-width="1.5"/>`;
    if(!cis.length)s+=`<text x="${(P.x0+P.x1)/2}" y="${(P.y0+P.y1)/2}" class="al" text-anchor="middle">按上方按鈕產生 20 個信賴區間</text>`;
    put(el,w,H,s,'20 個信賴區間');
    $('w6ciread').innerHTML=cis.length?`<div><small>樣本人數</small><strong>${n}</strong></div><div><small>蓋到真值的區間</small><strong>${hit} ／ 20</strong></div><div><small>區間平均寬度</small><strong>${fx(mean(cis.map(c=>c[2]-c[0])))} 天</strong></div>`:'';}
  Draw[6]=()=>{drawPop();drawSamp();drawCI();};
})();
</script>
<script>
/* ---------- W7 假設檢定 ---------- */
(function(){
  let a=0.05;const zc={0.01:2.576,0.05:1.96,0.1:1.645},SD=15;
  ['w7d','w7n'].forEach(id=>$(id).oninput=()=>Draw[7]());
  const seg=$('w7a');seg.querySelectorAll('.btn').forEach(b=>b.onclick=()=>{a=+b.dataset.a;pressOne(seg,b);Draw[7]();});
  $('w7obs').oninput=()=>Draw[7]();
  function drawP(){const obs=+$('w7obs').value,se=15*Math.sqrt(2/20),p=obs>0?2*(1-phi(obs/se)):1,c=1.96*se;$('w7obsv').textContent=obs+' 分';
    const el=$('w7pfig'),w=W(el),H=250,lo=-16,hi=16,P=new Plot(w,H,{l:20,r:16,t:40,b:40},[lo,hi],[0,dnorm(0,0,se)*1.12]);
    let s=P.axes({xt:w<430?[-15,-10,-5,0,5,10,15]:ticks(lo,hi,8),xl:'兩組平均差（分）'});
    const area=(x0,x1)=>{if(x1<=x0)return'';let q=`M${P.x(x0)} ${P.y0}`;for(let x=x0;x<=x1+1e-9;x+=(x1-x0)/60)q+=`L${P.x(x).toFixed(1)} ${P.y(dnorm(x,0,se)).toFixed(1)}`;return `<path d="${q}L${P.x(x1)} ${P.y0}Z" fill="${C.redL}" stroke="none"/>`;};
    s+=obs>0?area(Math.min(obs,hi),hi)+area(lo,Math.max(-obs,lo)):area(lo,hi);
    let d='';for(let x=lo;x<=hi;x+=0.2)d+=(d?'L':'M')+P.x(x).toFixed(1)+' '+P.y(dnorm(x,0,se)).toFixed(1);s+=`<path d="${d}" fill="none" stroke="${C.mute}" stroke-width="2"/>`;
    [c,-c].forEach(v=>{s+=`<line x1="${P.x(v)}" x2="${P.x(v)}" y1="${P.y1-22}" y2="${P.y0}" stroke="${C.mute}" stroke-dasharray="3 4"/>`;});
    s+=`<text x="${P.x(c)+4}" y="${P.y1-24}" class="tk">p ＝ 0.05 的界線</text>`;
    if(obs>0){s+=`<line x1="${P.x(obs)}" x2="${P.x(obs)}" y1="${P.y1-6}" y2="${P.y0}" stroke="${C.red}" stroke-width="2.5"/><line x1="${P.x(-obs)}" x2="${P.x(-obs)}" y1="${P.y1-6}" y2="${P.y0}" stroke="${C.red}" stroke-width="1.8" stroke-dasharray="5 3"/><text x="${P.x(obs)+5}" y="${P.y1-6}" class="al" style="fill:${C.red};font-weight:700">你的結果 ${obs} 分</text>`;}
    if(w>=430)s+=`<text x="${P.x(0)}" y="${P.y(dnorm(0,0,se))-8}" class="tk" text-anchor="middle">方案無效時的差距分布</text>`;
    put(el,w,H,s,'p 值示意圖');
    const pct=p<0.001?'不到 0.1%':fx(p*100)+'%';
    $('w7psay').innerHTML=`如果方案其實無效，光靠巧合看到差距 ${obs} 分以上（往任一方向）的機率是 <b>${pct}</b>，這就是 p 值。`+(p<0.05?`p 小於 0.05：這麼大的差距很難用巧合解釋，所以推翻「方案無效」的假設，判定<b>統計上顯著</b>。`:`p 沒有小於 0.05：這種差距光靠巧合就常出現，<b>還不能說方案有效</b>。`);
    $('w7pread').innerHTML=`<div><small>標準誤</small><strong>${fx(se,2)} 分</strong></div><div><small>差距是標準誤的幾倍（z）</small><strong>${fx(obs/se,2)}</strong></div><div><small>p 值</small><strong style="color:${p<0.05?C.teal:C.ink}">${fp(p)}</strong></div>`;}
  const drawPow=function(){const d=+$('w7d').value,n=+$('w7n').value,se=SD*Math.sqrt(2/n),z=zc[a],c=z*se;$('w7dv').textContent=d;$('w7nv').textContent=n;$('w7dtxt').textContent=d;
    const pw=1-phi((c-d)/se)+phi((-c-d)/se);
    const el=$('w7fig'),w=W(el),H=250,lo=-20,hi=30,P=new Plot(w,H,{l:20,r:16,t:30,b:40},[lo,hi],[0,dnorm(0,0,se)*1.15]);
    let s=P.axes({xt:w<430?[-20,-10,0,10,20,30]:ticks(lo,hi,10),xl:'兩組平均差（分）'});
    const area=(m,x0,x1,fill,op)=>{if(x1<=x0)return'';let p=`M${P.x(x0)} ${P.y0}`;for(let x=x0;x<=x1+1e-9;x+=(x1-x0)/80)p+=`L${P.x(x).toFixed(1)} ${P.y(dnorm(x,m,se)).toFixed(1)}`;return `<path d="${p}L${P.x(x1)} ${P.y0}Z" fill="${fill}" fill-opacity="${op}"/>`;};
    const cl=Math.max(lo,Math.min(hi,c)),ncl=Math.max(lo,-c);
    s+=area(d,ncl,cl,C.satL,1)+area(d,cl,hi,C.tealM,.85)+area(d,lo,ncl,C.tealM,.85)+area(0,cl,hi,C.redL,.9)+area(0,lo,ncl,C.redL,.9);
    const curve=(m,col,wd)=>{let p='';for(let x=lo;x<=hi;x+=0.25)p+=(p?'L':'M')+P.x(x).toFixed(1)+' '+P.y(dnorm(x,m,se)).toFixed(1);return `<path d="${p}" fill="none" stroke="${col}" stroke-width="${wd}"/>`;};
    s+=curve(0,C.mute,1.8)+curve(d,C.teal,2.2);
    [c,-c].forEach(v=>{if(v>lo&&v<hi)s+=`<line x1="${P.x(v)}" x2="${P.x(v)}" y1="${P.y1-8}" y2="${P.y0}" stroke="${C.red}" stroke-dasharray="4 3"/>`;});
    if(c<hi)s+=`<text x="${P.x(c)+4}" y="${P.y1-12}" class="al" style="fill:${C.red}">臨界值 ${fx(c)} 分</text>`;
    const pk=P.y(dnorm(0,0,se))-8,far=d>=7;s+=`<text x="${far||d===0?P.x(0):P.x(0)-4}" y="${pk}" class="al" text-anchor="${far||d===0?'middle':'end'}">方案無效</text>`;if(d>0)s+=`<text x="${far?P.x(d):P.x(d)+4}" y="${pk}" class="al" text-anchor="${far?'middle':'start'}" style="fill:${C.teal};font-weight:700">方案有效</text>`;
    put(el,w,H,s,'檢定力示意圖');
    const need=d>0?Math.ceil(2*((z+0.8416)**2)*SD*SD/(d*d)):null;
    $('w7read').innerHTML=`<div><small>標準誤</small><strong>${fx(se,2)} 分</strong></div><div><small>要觀察到的差距才會顯著</small><strong>≥ ${fx(c)} 分</strong></div><div><small>檢定力 1−β</small><strong style="color:${C.teal}">${fx(pw*100,0)}%</strong></div><div><small>型二錯誤 β</small><strong>${d>0?fx((1-pw)*100,0)+'%':'—'}</strong></div>`+(need?`<div><small>達 80% 檢定力每組需要</small><strong>${need} 人</strong></div>`:'');
    let t;if(d===0)t=`真實效果為 0 時，綠色和灰色曲線重疊。這時研究得到的任何「顯著」都是型一錯誤，發生機率就是 α ＝ ${a}。`;
    else if(pw<0.5)t=`檢定力只有 <b>${fx(pw*100,0)}%</b>：方案真的讓分數多 ${d} 分，但同樣的研究做 10 次，大約只有 ${Math.round(pw*10)} 次會得到 p &lt; ${a}。人數不足時，「沒有顯著差異」不能解讀成「方案無效」。`;
    else if(pw<0.8)t=`檢定力 ${fx(pw*100,0)}%，還沒達到常見的 80% 標準，每組增加到約 ${need} 人會比較穩。`;
    else t=`檢定力 ${fx(pw*100,0)}%，已達 80% 標準。只要觀察到的差距超過 ${fx(c)} 分，就會判定顯著。`;
    $('w7say').innerHTML=t;};
  Draw[7]=()=>{drawP();drawPow();};
})();

/* ---------- W10 ANOVA ---------- */
(function(){
  const r=rng(31),k=3,n=15,eff=[-1,0,1],names=['一般照護區','失智專區','重度失能區'];
  const Z=eff.map(()=>{const z=Array.from({length:n},()=>randn(r)),m=mean(z),s=sd(z);return z.map(v=>(v-m)/s);});
