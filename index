    const eb=$('w4box'),B=new Plot(w,74,{l:48,r:16,t:14,b:26},[0,hi],[0,1]),iqr=q3-q1,lw=Math.min(...d.filter(v=>v>=q1-1.5*iqr)),uw=Math.max(...d.filter(v=>v<=q3+1.5*iqr)),yc=B.y(.5);
    let b=`<text x="${B.x0-6}" y="${yc+4}" class="tk" text-anchor="end">盒鬚圖</text><line x1="${B.x(lw)}" x2="${B.x(q1)}" y1="${yc}" y2="${yc}" stroke="${C.ink}"/><line x1="${B.x(q3)}" x2="${B.x(uw)}" y1="${yc}" y2="${yc}" stroke="${C.ink}"/><line x1="${B.x(uw)}" x2="${B.x(uw)}" y1="${yc-8}" y2="${yc+8}" stroke="${C.ink}"/><line x1="${B.x(lw)}" x2="${B.x(lw)}" y1="${yc-8}" y2="${yc+8}" stroke="${C.ink}"/>`;
    b+=`<rect x="${B.x(q1)}" y="${yc-14}" width="${Math.max(1,B.x(q3)-B.x(q1))}" height="28" fill="${C.tealL}" stroke="${C.teal}"/><line x1="${B.x(md)}" x2="${B.x(md)}" y1="${yc-14}" y2="${yc+14}" stroke="${C.teal}" stroke-width="3"/>`;
    d.filter(v=>v>uw).forEach(v=>{b+=`<circle cx="${B.x(v)}" cy="${yc}" r="4" fill="#fff" stroke="${C.red}" stroke-width="1.5"/>`;});
    b+=`<line x1="${B.x0}" x2="${B.x1}" y1="${B.y0}" y2="${B.y0}" class="ax"/>`;ticks(0,hi,6).forEach(v=>{b+=`<text x="${B.x(v)}" y="${B.y0+16}" class="tk" text-anchor="middle">${v}</text>`;});
    put(eb,w,74,b,'盒鬚圖');
    $('w4read').innerHTML=`<div><small>人數</small><strong>${d.length}</strong></div><div><small>平均數 ± 標準差</small><strong>${fx(m)} ± ${fx(sd(d))}</strong></div><div><small>中位數（四分位距）</small><strong>${fx(md)}（${fx(q1)}–${fx(q3)}）</strong></div>`;};
})();

/* ---------- W5 機率 ---------- */
(function(){
  const sl=['w5p','w5se','w5sp'];sl.forEach(id=>$(id).oninput=()=>Draw[5]());
  document.querySelectorAll('#lab5 [data-pre]').forEach(b=>b.onclick=()=>{$('w5p').value=b.dataset.pre;Draw[5]();});
  Draw[5]=function(){const pv=+$('w5p').value/100,se=+$('w5se').value/100,sp=+$('w5sp').value/100;$('w5pv').textContent=Math.round(pv*100)+'%';$('w5sev').textContent=Math.round(se*100)+'%';$('w5spv').textContent=Math.round(sp*100)+'%';
    const D=Math.round(1000*pv),TP=Math.round(D*se),FN=D-TP,H=1000-D,FP=Math.round(H*(1-sp)),TN=H-FP,ppv=TP/(TP+FP||1),npv=TN/(TN+FN||1);
    const el=$('w5grid'),w=W(el),cols=w<520?25:50,rows=1000/cols,cell=Math.min(15,(w-4)/cols),Hh=rows*cell+4,ox=(w-cols*cell)/2;let s='';
    const seq=[[TP,C.red,C.red],[FN,C.redL,C.red],[FP,C.sat,C.sat],[TN,C.grid,C.grid]];let i=0;
    seq.forEach(([n,f,st])=>{for(let k=0;k<n;k++,i++){const x=ox+(i%cols)*cell,y=2+Math.floor(i/cols)*cell;s+=`<rect x="${x+1}" y="${y+1}" width="${cell-2}" height="${cell-2}" rx="1.5" fill="${f}" stroke="${st}" stroke-width=".8"/>`;}});
    put(el,w,Hh,s,'1000 人的篩檢結果');
